# Copy to .env for local dev. NEVER commit a real .env.
# Postgres connection string used by the app, migrations, and tests.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ci_signal_trust

# HMAC-SHA256 secret used to verify the x-signature-256 header on /webhooks/ci.
INGEST_SIGNING_SECRET=replace-me-with-a-long-random-secret

# Bearer token required by GET /reports/ffr (Authorization: Bearer <token>).
READ_API_TOKEN=replace-me-with-a-long-random-token

# HTTP port (default 3000).
PORT=3000

# Rolling window (days) for FFR computation (default 14).
FFR_WINDOW_DAYS=14
